# Copy this file to .env and adjust if needed.

# Matches the credentials in the root docker-compose.yml
DATABASE_URL="postgresql://recipeuser:recipepass@localhost:5432/recipebox?schema=public"

PORT=4001

# Must match the client's dev server URL (Vite default)
CLIENT_URL="http://localhost:5173"

# One of: fatal, error, warn, info, debug, trace
LOG_LEVEL=info

NODE_ENV=development
