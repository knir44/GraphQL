generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Recipe {
  id              String       @id @default(uuid())
  title           String
  description     String?
  emoji           String?
  imageUrl        String?
  prepTimeMinutes Int
  difficulty      Difficulty
  tags            String[]
  steps           String[]
  isFavorite      Boolean      @default(false)
  ingredients     Ingredient[]
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
}

// onDelete: Cascade matters here — without it, deleteRecipe would fail
// with a foreign key constraint error whenever a recipe still has ingredients.
model Ingredient {
  id       String @id @default(uuid())
  name     String
  quantity String
  recipe   Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  recipeId String
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}
